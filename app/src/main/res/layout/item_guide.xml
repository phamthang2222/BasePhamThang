<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/tv_title"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_guide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentStart="true"
            android:scaleType="fitStart"
            android:src="@drawable/img_intro_1"
            app:layout_constraintDimensionRatio="360:375"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/lato_bold"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/title_intro_1"
        android:textColor="@color/neutral_800"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/rl_img" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:fontFamily="@font/lato_medium"
        android:gravity="center_horizontal"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:lineSpacingMultiplier="0.7"
        android:lineSpacingExtra="@dimen/_5sdp"
        android:text="@string/content_intro_1"
        android:maxLines="2"
        android:textColor="@color/neutral_500"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />
</androidx.constraintlayout.widget.ConstraintLayout>