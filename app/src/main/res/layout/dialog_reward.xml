<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="30dp"
    android:layout_marginHorizontal="32dp"
    android:background="@drawable/bg_white_r16"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="231dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/img_reward" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_24pt_semibold"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="@string/unlock_function"
                android:textColor="@color/black_in_app"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="@string/main_reword"
                android:textColor="@color/neutral_500"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llWatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_blue_r100"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_reward_1" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_medium"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:text="@string/watch_video"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@+id/seekBar2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWatchAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_blue_r100"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/imageView44"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_reward_1" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/tvWatchAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_medium"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:text="@string/content_2_reward_1"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@+id/seekBar2" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>
