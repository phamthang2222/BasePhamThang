<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity"
    tools:context="com.phamthang.base.ui.feature.home.HomeActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcvHome"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_home" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="3dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/collapsible_banner_container_view">

        <com.phamthang.base.custome_view.BottomViewNav
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="@drawable/rippleeffect"
            android:paddingVertical="12dp"
            app:backgroundIcon="@color/transparent"
            app:iconBottomNav="@drawable/state_icon_home"
            app:textTitle="@string/home" />

        <com.phamthang.base.custome_view.BottomViewNav
            android:id="@+id/statistic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="@drawable/rippleeffect"
            android:paddingVertical="12dp"
            app:backgroundIcon="@color/transparent"
            app:iconBottomNav="@drawable/state_icon_statistic"
            app:textTitle="@string/statistic" />

        <com.phamthang.base.custome_view.BottomViewNav
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="@drawable/rippleeffect"
            android:paddingVertical="12dp"
            app:backgroundIcon="@color/transparent"
            app:iconBottomNav="@drawable/state_icon_setting"
            app:textTitle="@string/settings"

            />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/collapsible_banner_container_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>